<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="http://onder.de/OCMate" version="1.8.0" viewmodes="fullscreen">
    <!-- Zugriff auf alle Server (Playlist, EPG, Logos, Streams) -->
    <access origin="*" subdomains="true"></access>
    <tizen:application id="OCMateTV01.OCMate" package="OCMateTV01" required_version="3.0"/>
    <content src="index.html"/>
    <description>OCMate IPTV-Player</description>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="fullscreen"/>
    <name>OCMate</name>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
